generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  UserId       String   @id(map: "PK_User") @default(uuid()) @db.Uuid
  Email        String   @unique(map: "UQ_User_Email") @db.VarChar(255)
  Username     String   @db.VarChar(100)
  PasswordHash String?  @db.VarChar(100)
  IsActive     Boolean  @default(true)
  CreatedDate  DateTime @default(now())
  ModifiedDate DateTime @updatedAt

  Logins              UserLogin[]
  RefreshTokens       RefreshToken[]
  LibraryCards        LibraryCard[]
  WorkspaceFretboards WorkspaceFretboard[]
  ChordProgression    ChordProgression?
}

model UserLogin {
  UserLoginId    String   @id(map: "PK_UserLogin") @default(uuid()) @db.Uuid
  UserId         String   @db.Uuid
  Provider       String   @db.VarChar(20)
  ProviderUserId String   @db.VarChar(255)
  CreatedDate    DateTime @default(now())
  User           User     @relation(fields: [UserId], references: [UserId], onDelete: Cascade, map: "FK_UserLogin_User")

  @@unique([Provider, ProviderUserId], map: "UQ_UserLogin_Provider_ProviderUserId")
  @@index([UserId], map: "IX_UserLogin_UserId")
}

model RefreshToken {
  TokenId     String    @id(map: "PK_RefreshToken") @default(uuid()) @db.Uuid
  UserId      String    @db.Uuid
  TokenHash   String    @unique(map: "UQ_RefreshToken_TokenHash") @db.Char(64)
  FamilyId    String    @db.Uuid
  ExpiresAt   DateTime
  RevokedAt   DateTime?
  CreatedDate DateTime  @default(now())
  User        User      @relation(fields: [UserId], references: [UserId], onDelete: Cascade, map: "FK_RefreshToken_User")

  @@index([UserId], map: "IX_RefreshToken_UserId")
  @@index([FamilyId], map: "IX_RefreshToken_FamilyId")
}

model LibraryCard {
  CardId       String   @id(map: "PK_LibraryCard") @default(uuid()) @db.Uuid
  UserId       String   @db.Uuid
  Name         String   @db.VarChar(100)
  Setup        String   @db.VarChar(10)
  IsFavorite   Boolean  @default(false)
  CreatedDate  DateTime @default(now())
  ModifiedDate DateTime @updatedAt
  User         User     @relation(fields: [UserId], references: [UserId], onDelete: Cascade, map: "FK_LibraryCard_User")
  Fretboards   CardFretboard[]

  @@index([UserId, CreatedDate], map: "IX_LibraryCard_UserId_CreatedDate")
}

model CardFretboard {
  CardFretboardId String      @id(map: "PK_CardFretboard") @default(uuid()) @db.Uuid
  CardId          String      @db.Uuid
  Position        Int
  KeyName         String      @db.VarChar(5)
  Accidental      String      @db.VarChar(10)
  Tonality        String      @db.VarChar(10)
  Pattern         String      @db.VarChar(50)
  FretAmount      Int
  ChordPosition   Int
  ChordView       String?     @db.VarChar(10)
  ShapeC          Boolean
  ShapeA          Boolean
  ShapeG          Boolean
  ShapeE          Boolean
  ShapeD          Boolean
  StringLowE      Boolean
  StringA         Boolean
  StringD         Boolean
  StringG         Boolean
  StringB         Boolean
  StringHighE     Boolean
  HighlightNotes  String      @db.VarChar(500)
  Card            LibraryCard @relation(fields: [CardId], references: [CardId], onDelete: Cascade, map: "FK_CardFretboard_LibraryCard")

  @@unique([CardId, Position], map: "UQ_CardFretboard_CardId_Position")
}

model WorkspaceFretboard {
  WorkspaceFretboardId String  @id(map: "PK_WorkspaceFretboard") @default(uuid()) @db.Uuid
  UserId               String  @db.Uuid
  Setup                String  @db.VarChar(10)
  Position             Int
  KeyName              String  @db.VarChar(5)
  Accidental           String  @db.VarChar(10)
  Tonality             String  @db.VarChar(10)
  Pattern              String  @db.VarChar(50)
  FretAmount           Int
  ChordPosition        Int
  ChordView            String? @db.VarChar(10)
  ShapeC               Boolean
  ShapeA               Boolean
  ShapeG               Boolean
  ShapeE               Boolean
  ShapeD               Boolean
  StringLowE           Boolean
  StringA              Boolean
  StringD              Boolean
  StringG              Boolean
  StringB              Boolean
  StringHighE          Boolean
  HighlightNotes       String  @db.VarChar(500)
  User                 User    @relation(fields: [UserId], references: [UserId], onDelete: Cascade, map: "FK_WorkspaceFretboard_User")

  @@unique([UserId, Setup, Position], map: "UQ_WorkspaceFretboard_UserId_Setup_Position")
}

model ChordProgression {
  UserId       String             @id(map: "PK_ChordProgression") @db.Uuid
  KeyName      String             @db.VarChar(5)
  Tonality     String             @db.VarChar(10)
  ModifiedDate DateTime           @updatedAt
  User         User               @relation(fields: [UserId], references: [UserId], onDelete: Cascade, map: "FK_ChordProgression_User")
  Chords       ProgressionChord[]
}

model ProgressionChord {
  ProgressionChordId String           @id(map: "PK_ProgressionChord") @default(uuid()) @db.Uuid
  UserId             String           @db.Uuid
  Position           Int
  Degree             Int
  Progression        ChordProgression @relation(fields: [UserId], references: [UserId], onDelete: Cascade, map: "FK_ProgressionChord_ChordProgression")

  @@unique([UserId, Position], map: "UQ_ProgressionChord_UserId_Position")
}
